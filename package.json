{
  "name": "museone-pharma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.mts",
    "e2e": "playwright test",
    "test:db": "cross-env TEST_DB=1 node --env-file=.env node_modules/vitest/vitest.mjs run",
    "screens": "playwright test --config playwright.screens.config.ts"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "dexie": "4.4.7",
    "drizzle-orm": "0.45.4",
    "jsbarcode": "3.11.6",
    "mysql2": "3.24.6",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@9.15.9"
}
